{
    // ============================================================
    // Python 解释器：强制使用 torch_env（PyTorch CUDA + 全 ML 栈）
    // ============================================================
    "python.defaultInterpreterPath": "C:\\Users\\LENOVO\\anaconda3\\envs\\torch_env\\python.exe",
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateEnvInCurrentTerminal": true,

    // ============================================================
    // Jupyter Notebook
    // ============================================================
    "jupyter.interactiveWindow.textEditor.executeSelection": true,
    "jupyter.askForKernelRestart": false,
    "jupyter.notebookFileRoot": "${workspaceFolder}",

    // ============================================================
    // 语言服务器 & 类型检查
    // ============================================================
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.indexing": true,
    "python.analysis.packageIndexDepths": [
        { "name": "torch", "depth": 3 },
        { "name": "tensorflow", "depth": 3 },
        { "name": "transformers", "depth": 2 },
        { "name": "numpy", "depth": 2 },
        { "name": "pandas", "depth": 2 }
    ],

    // ============================================================
    // 格式化（保存时自动）
    // ============================================================
    "editor.formatOnSave": true,
    "python.formatting.provider": "none",
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },

    // ============================================================
    // Linting（Ruff 速度快，覆盖 flake8+isort）
    // ============================================================
    "python.linting.enabled": true,
    "python.linting.ruffEnabled": true,
    "python.linting.ruffArgs": [
        "--line-length=100",
        "--ignore=E501"
    ],

    // ============================================================
    // 测试（pytest）
    // ============================================================
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "--tb=short",
        "-v"
    ],
    "python.testing.autoTestDiscoverOnSaveEnabled": true,

    // ============================================================
    // 文件关联
    // ============================================================
    "files.associations": {
        "*.ipynb": "jupyter-notebook"
    },

    // ============================================================
    // 排除干扰文件
    // ============================================================
    "files.exclude": {
        "**/.git": false,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.ipynb_checkpoints": true
    },
    "files.watcherExclude": {
        "**/__pycache__/**": true,
        "**/.ipynb_checkpoints/**": true
    },

    // ============================================================
    // 终端
    // ============================================================
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "args": ["-NoLogo", "-NoExit", "-Command", "conda activate torch_env"]
        }
    },

    // ============================================================
    // 编辑器行为
    // ============================================================
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.renderWhitespace": "boundary",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true
}
