{
    // ============================================================
    // Python 解释器：强制使用 torch_env（PyTorch CUDA + 全 ML 栈）
    // ============================================================
    "python.defaultInterpreterPath": "C:\\Users\\LENOVO\\anaconda3\\envs\\torch_env\\python.exe",
    "python.terminal.activateEnvironment": false,
    "python.terminal.activateEnvInCurrentTerminal": false,
    // ============================================================
    // Jupyter Notebook
    // ============================================================
    "jupyter.interactiveWindow.textEditor.executeSelection": true,
    "jupyter.askForKernelRestart": false,
    "jupyter.notebookFileRoot": "${workspaceFolder}",
    "jupyter.logging.level": "off",
    "jupyter.runStartupCommands": [],
    // ============================================================
    // 语言服务器 & 类型检查
    // ============================================================
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.indexing": false,
    "python.analysis.exclude": [
        "**/d2l-zh/**",
        "**/torch_env/**"
    ],
    "python.analysis.packageIndexDepths": [
        {
            "name": "torch",
            "depth": 1
        },
        {
            "name": "tensorflow",
            "depth": 1
        },
        {
            "name": "transformers",
            "depth": 1
        },
        {
            "name": "numpy",
            "depth": 1
        },
        {
            "name": "pandas",
            "depth": 1
        }
    ],
    // ============================================================
    // 格式化（保存时自动）
    // ============================================================
    "editor.formatOnSave": true,
    "python.formatting.provider": "none",
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    // ============================================================
    // Linting（已关闭以减少 Pylance 负载，需要时重新启用）
    // ============================================================
    "python.linting.enabled": false,
    "python.linting.ruffEnabled": false,
    "python.linting.ruffArgs": [
        "--line-length=100",
        "--ignore=E501"
    ],
    // ============================================================
    // 测试（pytest）
    // ============================================================
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "--tb=short",
        "-v"
    ],
    "python.testing.autoTestDiscoverOnSaveEnabled": false,
    // ============================================================
    // 文件关联
    // ============================================================
    "files.associations": {
        "*.ipynb": "jupyter-notebook"
    },
    // ============================================================
    // 排除干扰文件
    // ============================================================
    "files.exclude": {
        "**/.git": false,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.ipynb_checkpoints": true
    },
    "files.watcherExclude": {
        "**/__pycache__/**": true,
        "**/.ipynb_checkpoints/**": true,
        "**/d2l-zh/**": true
    },
    "search.exclude": {
        "**/d2l-zh/**": true
    },
    // ============================================================
    // 终端
    // ============================================================
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "args": [
                "-NoLogo",
                "-NoExit",
                "-Command",
                "conda activate torch_env"
            ]
        }
    },
    // ============================================================
    // 编辑器行为
    // ============================================================
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.renderWhitespace": "boundary",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    // ============================================================
    // 补全建议：全局开启快速建议，关闭内联建议（Copilot 幽灵文本）
    // ============================================================
    // 普通编辑器：按字符触发快速建议
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": true
    },
    // 关闭内联建议（Ghost text / Copilot-style）
    "editor.inlineSuggest.enabled": false,
    // ============================================================
    // Notebook 内快速建议（.ipynb 单元格内）
    // ============================================================
    "notebook.suggest.enabled": true,
    "notebook.inlineSuggest.enabled": false,
    // Notebook 快速建议：输入时自动弹出补全列表
    "notebook.quickSuggestions": true,
    // 针对 Python / Notebook 禁用 Copilot，避免干扰原生建议
    "github.copilot.enable": {
        "*": true,
        "python": false,
        "jupyter-notebook": false
    },
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda"
}
